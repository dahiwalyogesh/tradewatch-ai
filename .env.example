# TradeWatch — environment variables
# Local use: copy this file to .env and fill in your values.
# On Render: add these under your service → Environment. Never commit real keys.

# Flask session secret — any long random string
SECRET_KEY=change-me-to-a-random-string

# Password for /admin (admin login is disabled if this is blank)
ADMIN_PASSWORD=

# Optional server-side AI keys. If set, visitors can leave the key box
# blank and the app uses these. Leave any blank to require the visitor's own key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override AI model names if a provider retires one
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile
